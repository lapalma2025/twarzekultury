# === Supabase ===
# Project Settings → API / Connect panel:
#   Project URL  → NEXT_PUBLIC_SUPABASE_URL
#   Publishable  → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (sb_publishable_…)
#   Secret       → SUPABASE_SECRET_KEY                  (sb_secret_…)  — tylko serwer
#
# Dopóki URL/klucz publishable są puste, portal działa na lokalnym magazynie
# (data/db.json). Po uzupełnieniu i uruchomieniu supabase/schema.sql aplikacja
# automatycznie przełącza się na Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy aliases (opcjonalne — działają też stare nazwy anon / service_role)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# === Strona ===
# Canonical / sitemap / Open Graph — produkcyjna domena.
# Na localhost strona działa normalnie; tylko meta SEO wskazują na ten URL.
NEXT_PUBLIC_SITE_URL=https://twarzekultury.pl

# === Logowanie do panelu admina (tryb lokalny, przed podpięciem Supabase Auth) ===
# Wygeneruj hash: node scripts/hash-password.mjs "twoje-haslo"
# WAŻNE: w wartości hasha wyescapuj znaki $ jako \$ (Next.js inaczej spróbuje je
# rozwinąć jako odwołania do zmiennych środowiskowych i hash zostanie ucięty).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Losowy, długi ciąg znaków (np. `openssl rand -hex 32`) — podpisuje sesję admina.
SESSION_SECRET=
